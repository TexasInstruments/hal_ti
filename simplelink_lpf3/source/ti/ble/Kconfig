config BT_CTLR_TI_LEGACY_CMD
	bool "TI BLE Controller Legacy HCI Commands"
	default y
	help
	  Enable support for legacy HCI commands in the TI BLE controller
	  (e.g., HCI_LE_Set_Advertising_Parameters, HCI_LE_Set_Scan_Parameters).
	  Disable this option to reduce code size if legacy commands are not needed.

config BT_CTLR_TI_EXT_VS_CMD
	bool "TI BLE Controller Extended Vendor Specific Commands"
	default y if BT_HCI_RAW
	default n
	help
	  Enable support for extended vendor specific HCI commands in the
	  TI BLE controller. Disable this option to reduce code size if
	  extended vendor specific commands are not needed.

config BT_CTRL_TI_VS_RSSI_MONITOR
	bool "TI BLE Controller Vendor Specific RSSI Monitor"
	default n
	help
	  Enable the TI vendor-specific RSSI Monitor feature. Tracks received
	  signal strength per connection using a weighted average and invokes
	  registered callbacks when RSSI crosses configurable high/low thresholds
	  or returns to range.

config BT_TI_SWAT_TEST_MODE
	bool "TI BLE SWAT Test Mode (Internal TI Test Lab Only)"
	depends on BT_HCI_RAW
	default n
	help
	  Enable special test mode for TI SWAT (Software Automation Test) lab.
	  When enabled, vendor-specific LE meta events are NOT converted to
	  HCI Command Complete events, allowing direct testing of vendor-specific
	  event handling in the TI test lab.

	  This option should ONLY be enabled for internal TI testing and
	  validation purposes. It is NOT intended for production use or
	  customer applications.

	  Default: n (disabled)
